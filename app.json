{
  "expo": {
    "name": "ONEQUESTION",
    "slug": "onequestion-mobile-new",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onequestionmobilenew",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.onequestion.app"
    },
    "android": {
  "icon": "./assets/images/icon.png",
  "versionCode": 2,
  "predictiveBackGestureEnabled": false,
  "package": "com.anonymous.onequestionmobilenew"
},
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "402a2687-1068-49c7-8fa9-01423389c94a"
      }
    }
  }
}